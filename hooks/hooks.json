{
  "description": "Apex guardrails: the auditor is read-only (writes limited to .apex/ audit files), its Bash is a read-only allowlist, it can't read secrets, observed URLs are logged for provenance, its output is linted before it may finish, and Apex-managed files are protected for every agent.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/apex.py\" hook guard-writes", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/apex.py\" hook guard-bash", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/apex.py\" hook guard-reads", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/apex.py\" hook search-log", "timeout": 10 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "apex-auditor",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/apex.py\" hook subagent-stop", "timeout": 60 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/apex.py\" hook session-start", "timeout": 10 }
        ]
      }
    ]
  }
}
